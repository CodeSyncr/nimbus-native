package presentation

import (
	"context"

	"github.com/CodeSyncr/nimbus-native/ui"
	"github.com/CodeSyncr/nimbus-native/ui/render"

	"__MODULE__/features/orders/data"
	"__MODULE__/features/orders/domain"
	"__MODULE__/shared/widgets"
)

// NewOrderScreen places an order. It has no rules of its own: the server
// validates, and its errors land on the fields.
type NewOrderScreen struct{}

func (NewOrderScreen) Render(c *ui.Ctx) *ui.Element {
	th, modals := ui.UseTheme(c), ui.Modals(c)
	form := ui.UseForm(c, domain.NewOrder{}, nil)
	place := ui.UseAction(c, func(ctx context.Context, o domain.NewOrder) (domain.Order, error) {
		created, err := data.Create(ctx, o)
		form.SetErrors(err)
		return created, err
	}, func(domain.Order) {
		ui.RefetchQuery(c, data.ListKey)
		modals.Dismiss()
	})
	return ui.SafeArea(ui.Style{Grow: 1, Padding: ui.All(th.SpaceL), Gap: 16},
		ui.TextField(form.Field("customer", func(o *domain.NewOrder) *string { return &o.Customer }),
			ui.FieldOptions{Label: "Customer", Placeholder: "Customer name"}),
		ui.TextField(form.Field("phone", func(o *domain.NewOrder) *string { return &o.Phone }),
			ui.FieldOptions{Label: "Phone", Placeholder: "10-digit mobile", Keyboard: render.KeyboardNumber}),
		ui.C(widgets.Button{Label: "Place order", BusyLabel: "Placing…", Busy: place.Running,
			OnPress: func() { place.Run(form.Value()) }}).TestID("place"),
	)
}
