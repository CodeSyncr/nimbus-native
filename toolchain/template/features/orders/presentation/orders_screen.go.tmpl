// Package presentation is the orders feature's screens.
package presentation

import (
	"context"
	"fmt"

	"github.com/CodeSyncr/nimbus-native/ui"

	"__MODULE__/core/utils"
	"__MODULE__/features/orders/data"
	"__MODULE__/features/orders/domain"
	"__MODULE__/shared/services"
	"__MODULE__/shared/widgets"
)

// OrdersScreen is the signed-in user's orders (the page at /orders).
type OrdersScreen struct{}

func (OrdersScreen) Render(c *ui.Ctx) *ui.Element {
	if !services.SignedIn(c) {
		return ui.C(widgets.SignInPrompt{Message: "Sign in to see your orders"})
	}
	return ui.C(ordersList{email: services.Session.Use(c).Email})
}

// ordersList is keyed by the user, so another sign-in loads its own orders.
type ordersList struct{ email string }

func (l ordersList) Render(c *ui.Ctx) *ui.Element {
	client := services.API(c)
	q := ui.UseQuery(c, data.ListKey+l.email, func(ctx context.Context) ([]domain.Order, error) { return data.List(ctx, client) })
	switch {
	case q.Err != nil && !q.Loaded:
		return ui.C(widgets.Problem{Message: q.Err.Error(), Retry: q.Refetch})
	case !q.Loaded:
		return widgets.Loading()
	case len(q.Data) == 0:
		return ui.C(widgets.Empty{Message: "No orders yet", Action: "Browse the shop", Path: "/products"})
	}
	orders := q.Data
	return ui.SafeArea(ui.Style{Grow: 1},
		ui.List(len(orders), func(i int) *ui.Element { return ui.C(OrderRow{orders[i]}) }, ui.Flex(1)).
			ItemKey(func(i int) string { return fmt.Sprint(orders[i].ID) }).
			OnRefresh(q.Loading, q.Refetch).TestID("orders"),
	)
}

// OrderScreen is one order (the page at /orders/:id).
type OrderScreen struct{ ID int }

func (s OrderScreen) Render(c *ui.Ctx) *ui.Element {
	th, client := ui.UseTheme(c), services.API(c)
	if !services.SignedIn(c) {
		return ui.C(widgets.SignInPrompt{Message: "Sign in to see this order"})
	}
	q := ui.UseQuery(c, data.OrderKey(s.ID), func(ctx context.Context) (domain.Order, error) { return data.Get(ctx, client, s.ID) })
	switch {
	case q.Err != nil && !q.Loaded:
		return ui.C(widgets.Problem{Message: q.Err.Error(), Retry: q.Refetch})
	case !q.Loaded:
		return widgets.Loading()
	}
	o := q.Data
	fg, bg := statusColors(th, o.Status)
	lines := []*ui.Element{}
	for _, l := range o.Lines {
		lines = append(lines, ui.View(ui.Style{Direction: ui.Row, AlignItems: ui.AlignCenter, Gap: th.SpaceM},
			ui.Text(l.Emoji, ui.Style{FontSize: 22}),
			ui.Text(fmt.Sprintf("%s × %d", l.Name, l.Qty), ui.Style{Grow: 1, Shrink: 1}),
			ui.Text(utils.Money(l.Price*float64(l.Qty)), ui.Style{FontWeight: 600}),
		))
	}
	return ui.SafeArea(ui.Style{Grow: 1, Padding: ui.All(th.SpaceL), Gap: th.SpaceL},
		ui.View(ui.Style{Direction: ui.Row, Justify: ui.JustifySpaceBetween, AlignItems: ui.AlignCenter},
			ui.Text(fmt.Sprintf("Order #%d", o.ID), ui.Style{FontSize: th.Title, FontWeight: 700}).TestID("order-title"),
			widgets.Badge(string(o.Status), fg, bg),
		),
		ui.View(ui.Style{Background: th.Surface, Radius: th.Radius, Padding: ui.All(th.SpaceL), Gap: th.SpaceM}, lines...),
		ui.View(ui.Style{Direction: ui.Row, Justify: ui.JustifySpaceBetween},
			ui.Text("Total", ui.Style{FontSize: th.Heading}),
			ui.Text(utils.Money(o.Total), ui.Style{FontSize: th.Heading, FontWeight: 700}).TestID("order-total"),
		),
		ui.Text("Placed "+utils.Date(o.Placed), ui.Style{Color: th.TextMuted, FontSize: th.Caption}),
	)
}
