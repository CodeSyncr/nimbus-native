// Package data fetches and places the signed-in user's orders.
package data

import (
	"context"
	"strconv"

	"github.com/CodeSyncr/nimbus-native/api"

	"__MODULE__/features/orders/domain"
)

// Query keys: screens showing orders refetch when one is placed.
const ListKey = "orders"

func OrderKey(id int) string { return "orders/" + strconv.Itoa(id) }

func List(ctx context.Context, client *api.Client) ([]domain.Order, error) {
	return api.Call(ctx, client, domain.ListOrders, api.None{})
}

func Get(ctx context.Context, client *api.Client, id int) (domain.Order, error) {
	return api.Call(ctx, client, domain.GetOrder, domain.OrderRef{ID: id})
}

func Place(ctx context.Context, client *api.Client, o domain.NewOrder) (domain.Order, error) {
	return api.Call(ctx, client, domain.PlaceOrder, o)
}
