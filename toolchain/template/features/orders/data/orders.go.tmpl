// Package data fetches and changes orders through the server.
package data

import (
	"context"
	"strconv"

	"github.com/CodeSyncr/nimbus-native/api"

	"__MODULE__/features/orders/domain"
	"__MODULE__/shared/services"
)

// Query keys: screens showing orders refetch when an order is placed.
const ListKey = "orders"

func OrderKey(id int) string { return "orders/" + strconv.Itoa(id) }

func List(ctx context.Context) ([]domain.Order, error) {
	return api.Call(ctx, services.API, domain.ListOrders, api.None{})
}

func Get(ctx context.Context, id int) (domain.Order, error) {
	return api.Call(ctx, services.API, domain.GetOrder, domain.OrderRef{ID: id})
}

func Create(ctx context.Context, o domain.NewOrder) (domain.Order, error) {
	return api.Call(ctx, services.API, domain.CreateOrder, o)
}

