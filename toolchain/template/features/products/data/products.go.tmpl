// Package data fetches the catalog.
package data

import (
	"context"
	"strconv"

	"github.com/CodeSyncr/nimbus-native/api"

	"__MODULE__/features/products/domain"
)

const ListKey = "products"

func ProductKey(id int) string { return "products/" + strconv.Itoa(id) }

func List(ctx context.Context, client *api.Client) ([]domain.Product, error) {
	return api.Call(ctx, client, domain.ListProducts, api.None{})
}

func Get(ctx context.Context, client *api.Client, id int) (domain.Product, error) {
	return api.Call(ctx, client, domain.GetProduct, domain.ProductRef{ID: id})
}
