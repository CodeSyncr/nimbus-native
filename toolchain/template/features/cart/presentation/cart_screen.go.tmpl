// Package presentation is the cart's screen and checkout.
package presentation

import (
	"context"
	"fmt"

	"github.com/CodeSyncr/nimbus-native/plugins/dialog"
	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"

	"__MODULE__/core/utils"
	"__MODULE__/features/cart/data"
	ordersdata "__MODULE__/features/orders/data"
	orders "__MODULE__/features/orders/domain"
	"__MODULE__/shared/services"
	"__MODULE__/shared/widgets"
)

// CartScreen is the cart and checkout (the page at /cart).
type CartScreen struct{}

func (CartScreen) Render(c *ui.Ctx) *ui.Element {
	th, cart := ui.UseTheme(c), data.Store.Use(c)
	signedIn := services.SignedIn(c)
	checkout := ui.UseAction(c, func(ctx context.Context, o orders.NewOrder) (orders.Order, error) {
		return ordersdata.Place(ctx, services.API(c), o)
	}, func(o orders.Order) {
		data.Store.Update(c, func(data.Cart) data.Cart { return nil })
		ui.RefetchQuery(c, ordersdata.ListKey+services.Session.Get(c).Email)
		router.Push(c, fmt.Sprintf("/orders/%d", o.ID))
		go dialog.Toast(context.Background(), "Order placed")
	})
	if len(cart) == 0 {
		return ui.C(widgets.Empty{Message: "Your cart is empty", Action: "Browse the shop", Path: "/products"})
	}
	rows := []*ui.Element{}
	for _, l := range cart {
		rows = append(rows, ui.C(cartRow{l}))
	}
	place := func() {
		if !signedIn {
			router.Push(c, "/login")
			return
		}
		checkout.Run(cart.Order())
	}
	label := "Check out · " + utils.Money(cart.Total())
	if !signedIn {
		label = "Sign in to check out"
	}
	var problem *ui.Element
	if checkout.Err != nil {
		problem = ui.Text(checkout.Err.Error(), ui.Style{Color: th.Danger, FontSize: th.Caption})
	}
	return ui.SafeArea(ui.Style{Grow: 1},
		ui.Scroll(ui.Style{Grow: 1, Shrink: 1}, rows...),
		ui.View(ui.Style{Padding: ui.All(th.SpaceL), Gap: th.SpaceM, Background: th.Surface},
			ui.View(ui.Style{Direction: ui.Row, Justify: ui.JustifySpaceBetween},
				ui.Text(fmt.Sprintf("%d items", cart.Count()), ui.Style{Color: th.TextMuted}),
				ui.Text(utils.Money(cart.Total()), ui.Style{FontWeight: 700}).TestID("cart-total"),
			),
			problem,
			ui.C(widgets.Button{Label: label, BusyLabel: "Placing your order…", Busy: checkout.Running, OnPress: place}).TestID("checkout"),
		),
	)
}

type cartRow struct{ l data.Line }

func (r cartRow) Render(c *ui.Ctx) *ui.Element {
	th, l := ui.UseTheme(c), r.l
	set := func(qty int) func() {
		return func() { data.Store.Update(c, func(ct data.Cart) data.Cart { return ct.Set(l.Product.ID, qty) }) }
	}
	step := func(label, id string, f func()) *ui.Element {
		return ui.Pressable(f, ui.Style{Width: ui.Pt(32), Height: ui.Pt(32), Radius: 16, BorderWidth: 1, BorderColor: th.Border,
			Justify: ui.JustifyCenter, AlignItems: ui.AlignCenter},
			ui.Text(label, ui.Style{FontSize: 18, Color: th.Primary})).TestID(id)
	}
	return ui.View(ui.Style{Direction: ui.Row, AlignItems: ui.AlignCenter, Gap: th.SpaceM, Padding: ui.XY(th.SpaceL, 12),
		Background: th.Surface, Margin: ui.Edges{Bottom: 1}},
		ui.Text(l.Product.Emoji, ui.Style{FontSize: 28}),
		ui.View(ui.Style{Grow: 1, Shrink: 1, Gap: 2},
			ui.Text(l.Product.Name, ui.Style{FontWeight: 600}),
			ui.Text(utils.Money(l.Product.Price*float64(l.Qty)), ui.Style{FontSize: th.Caption, Color: th.TextMuted}),
		),
		step("−", fmt.Sprint("less-", l.Product.ID), set(l.Qty-1)),
		ui.Text(fmt.Sprint(l.Qty), ui.Style{FontWeight: 600, Width: ui.Pt(24), TextAlign: ui.AlignCenter}).TestID(fmt.Sprint("qty-", l.Product.ID)),
		step("+", fmt.Sprint("more-", l.Product.ID), set(l.Qty+1)),
	)
}
