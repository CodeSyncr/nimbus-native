// Package data is the cart: kept in the app (per tab on the web) until
// checkout sends it to the server.
package data

import (
	"github.com/CodeSyncr/nimbus-native/ui"

	orders "__MODULE__/features/orders/domain"
	products "__MODULE__/features/products/domain"
)

// Line is a product in the cart.
type Line struct {
	Product products.Product
	Qty     int
}

// Cart is what is in the cart, in the order it was added.
type Cart []Line

// Store is the cart every screen sees.
var Store = ui.NewStore(func() Cart { return nil })

// Add puts one more of p in the cart.
func (c Cart) Add(p products.Product) Cart {
	out := append(Cart(nil), c...)
	for i := range out {
		if out[i].Product.ID == p.ID {
			out[i].Qty++
			return out
		}
	}
	return append(out, Line{Product: p, Qty: 1})
}

// Set changes a product's quantity; 0 removes it.
func (c Cart) Set(id, qty int) Cart {
	out := Cart{}
	for _, l := range c {
		if l.Product.ID == id {
			l.Qty = qty
		}
		if l.Qty > 0 {
			out = append(out, l)
		}
	}
	return out
}

// Count is how many items are in the cart.
func (c Cart) Count() int {
	n := 0
	for _, l := range c {
		n += l.Qty
	}
	return n
}

// Total is what the cart costs.
func (c Cart) Total() float64 {
	t := 0.0
	for _, l := range c {
		t += l.Product.Price * float64(l.Qty)
	}
	return t
}

// Order is the cart as a checkout: the server prices it.
func (c Cart) Order() orders.NewOrder {
	o := orders.NewOrder{}
	for _, l := range c {
		o.Lines = append(o.Lines, orders.NewLine{ProductID: l.Product.ID, Qty: l.Qty})
	}
	return o
}
