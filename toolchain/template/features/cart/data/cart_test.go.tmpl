package data

import (
	"testing"

	products "__MODULE__/features/products/domain"
)

func TestCart(t *testing.T) {
	tea := products.Product{ID: 1, Price: 249}
	mug := products.Product{ID: 5, Price: 599}
	c := Cart(nil).Add(tea).Add(mug).Add(tea)
	if c.Count() != 3 || c.Total() != 249*2+599 {
		t.Fatalf("count %d total %v", c.Count(), c.Total())
	}
	c = c.Set(1, 0)
	if len(c) != 1 || c[0].Product.ID != 5 {
		t.Fatalf("after removing tea: %+v", c)
	}
	if o := c.Order(); len(o.Lines) != 1 || o.Lines[0].Qty != 1 {
		t.Fatalf("order: %+v", o)
	}
}
