// Package utils holds small helpers that know nothing about the app.
package utils

import (
	"fmt"
	"strings"
)

// Money formats an amount in rupees with grouped thousands:
// 1249.5 → "₹1,249.50".
func Money(v float64) string {
	s := fmt.Sprintf("%.2f", v)
	whole, frac, _ := strings.Cut(s, ".")
	neg := strings.HasPrefix(whole, "-")
	whole = strings.TrimPrefix(whole, "-")
	var b strings.Builder
	for i, r := range whole {
		if i > 0 && (len(whole)-i)%3 == 0 {
			b.WriteByte(',')
		}
		b.WriteRune(r)
	}
	if neg {
		return "-₹" + b.String() + "." + frac
	}
	return "₹" + b.String() + "." + frac
}

// Initial is the first letter of a name, upper-cased: "asha" → "A".
func Initial(name string) string {
	for _, r := range strings.TrimSpace(name) {
		return strings.ToUpper(string(r))
	}
	return "?"
}
