// Package pages holds the app's pages: this file is the page at "/", and
// routes_gen.go (generated by every build) is the table of all of them.
package pages

import (
	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"

	"__MODULE__/features/counter/presentation"
)

type Page struct{}

func (Page) Title() string { return "__NAME__" }

// Head is the page's title and description for search engines and link
// previews (the web host puts it in <head>).
func (Page) Head() router.Head {
	return router.Head{Title: "__NAME__", Description: "A counter, in Go, on every screen."}
}

func (Page) Render(c *ui.Ctx) *ui.Element { return ui.C(presentation.CounterScreen{}) }
