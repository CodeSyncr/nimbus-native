// Package app is the root of the __NAME__ UI: the component every platform
// mounts. Screens live in features; pages/ gives them URLs.
package app

import (
	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"

	"__MODULE__/core/theme"
	"__MODULE__/pages"
)

// The app's URLs come from the folders in pages/: pages/page.go is "/",
// and pages/settings/page.go would be /settings. `nimbus native gen` (run
// by every build) writes the table, pages/routes_gen.go.
func init() { router.Register(pages.Routes) }

// The app's look, on phones and on the web (the server imports this package too).
func init() { theme.Apply() }

// App is the root component: the home page. To grow it into tabs and
// navigation stacks, see `nimbus native new --template shop`.
type App struct{}

func (App) Render(c *ui.Ctx) *ui.Element {
	home, _, _ := router.Match("/")
	return ui.C(home)
}
