package app

import (
	"fmt"

	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"

	cart "__MODULE__/features/cart/data"
	"__MODULE__/pages"
)

// The app's URLs come from the folders in pages/: pages/orders/_id/page.go
// is /orders/:id. `nimbus native gen` (run by every build) writes the table,
// pages/routes_gen.go. Screens navigate by path: router.Push(c, "/orders/42").
func init() { router.Register(pages.Routes) }

// Tab is a top-level destination: a page shown in its own navigation stack.
type Tab struct {
	Path string
	Icon string // an SF Symbol on iOS; on Android res/drawable/<name with _ for .>.xml
}

// Tabs are the app's tabs, in order.
var Tabs = []Tab{
	{Path: "/products", Icon: "bag"},
	{Path: "/cart", Icon: "cart"},
	{Path: "/orders", Icon: "list.bullet"},
	{Path: "/account", Icon: "person.crop.circle"},
}

// TabTitle is a tab's label: its page's title, with the cart's count.
func TabTitle(c *ui.Ctx, t Tab) string {
	page, _, ok := router.Match(t.Path)
	if !ok {
		return ""
	}
	title := router.TitleOf(page, t.Path)
	if t.Path == "/cart" {
		if n := cart.Store.Use(c).Count(); n > 0 {
			title = fmt.Sprintf("%s (%d)", title, n)
		}
	}
	return title
}
