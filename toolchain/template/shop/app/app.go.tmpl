// Package app is the root of the __NAME__ UI: the component every platform
// mounts. Screens live in features; pages/ gives them URLs.
package app

import (
	"context"

	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"

	"__MODULE__/core/theme"
	"__MODULE__/shared/services"
)

// The app's look, on phones and on the web (the server imports this package too).
func init() { theme.Apply() }

// App is the root component: a tab per entry in Tabs, each with its own
// navigation stack.
type App struct{}

func (App) Render(c *ui.Ctx) *ui.Element {
	ui.Effect(c, func(ctx context.Context) func() {
		services.RestoreSession(ctx, c) // signed in last time: still signed in
		return nil
	}, "restore")
	tabs := make([]ui.Tab, 0, len(Tabs))
	for _, t := range Tabs {
		page, _, ok := router.Match(t.Path)
		if !ok {
			continue // no page folder for this path
		}
		tabs = append(tabs, ui.Tab{Title: TabTitle(c, t), Icon: t.Icon, Screen: stack{router.TitleOf(page, t.Path), page}})
	}
	return ui.Tabs(ui.Flex(1), tabs...)
}

// stack is one tab's navigation stack.
type stack struct {
	title string
	root  ui.Component
}

func (s stack) Render(c *ui.Ctx) *ui.Element {
	return ui.Stack(s.title, s.root, ui.Flex(1))
}
