// Package product is the page at /products/:id; the _id folder is the parameter.
package product

import (
	"fmt"

	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"

	"__MODULE__/features/products/presentation"
)

type Page struct {
	ID int `param:"id"`
}

func (p Page) Title() string { return "Product" }

func (p Page) Head() router.Head {
	return router.Head{Title: fmt.Sprintf("Product %d", p.ID), Description: "From the shop's catalog."}
}

func (p Page) Render(c *ui.Ctx) *ui.Element { return ui.C(presentation.ProductScreen{ID: p.ID}) }
