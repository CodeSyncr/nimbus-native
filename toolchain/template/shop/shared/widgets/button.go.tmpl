// Package widgets holds components that any feature can use.
package widgets

import "github.com/CodeSyncr/nimbus-native/ui"

// Button is the app's primary button. While busy it shows busyLabel and
// ignores presses.
type Button struct {
	Label, BusyLabel string
	Busy             bool
	OnPress          func()
}

func (b Button) Render(c *ui.Ctx) *ui.Element {
	th := ui.UseTheme(c)
	label, press := b.Label, b.OnPress
	if b.Busy {
		label, press = b.BusyLabel, func() {}
	}
	return ui.Pressable(press,
		ui.Style{Background: th.Primary, Radius: th.Radius, Padding: ui.XY(16, 14), AlignItems: ui.AlignCenter},
		ui.Text(label, ui.Style{Color: th.OnPrimary, FontSize: th.Body, FontWeight: 600}),
	)
}
