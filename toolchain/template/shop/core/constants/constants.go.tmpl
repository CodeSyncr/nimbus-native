// Package constants holds values the whole app shares.
package constants

// AppName is the app's display name.
const AppName = "__NAME__"

// APIBaseURL is the server the app calls: `go run .` on this machine.
// 127.0.0.1 reaches it from the iOS simulator, and from an Android emulator
// once `adb reverse tcp:3333 tcp:3333` forwards the port (`nimbus native run
// android` does this). Point it at your deployed server for release builds.
const APIBaseURL = "http://127.0.0.1:3333"
