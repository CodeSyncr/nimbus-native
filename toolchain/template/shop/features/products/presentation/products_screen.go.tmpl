// Package presentation is the catalog's screens.
package presentation

import (
	"context"
	"fmt"

	"github.com/CodeSyncr/nimbus-native/plugins/dialog"
	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"

	"__MODULE__/core/utils"
	cart "__MODULE__/features/cart/data"
	"__MODULE__/features/products/data"
	"__MODULE__/features/products/domain"
	"__MODULE__/shared/services"
	"__MODULE__/shared/widgets"
)

// ProductsScreen is the catalog (the page at /products).
type ProductsScreen struct{}

func (ProductsScreen) Render(c *ui.Ctx) *ui.Element {
	client := services.API(c)
	q := ui.UseQuery(c, data.ListKey, func(ctx context.Context) ([]domain.Product, error) { return data.List(ctx, client) })
	switch {
	case q.Err != nil && !q.Loaded:
		return ui.C(widgets.Problem{Message: q.Err.Error(), Retry: q.Refetch})
	case !q.Loaded:
		return widgets.Loading()
	}
	ps := q.Data
	return ui.SafeArea(ui.Style{Grow: 1},
		ui.List(len(ps), func(i int) *ui.Element { return ui.C(ProductRow{ps[i]}) }, ui.Flex(1)).
			ItemKey(func(i int) string { return fmt.Sprint(ps[i].ID) }).
			OnRefresh(q.Loading, q.Refetch),
	)
}

// ProductRow is one product in the catalog: a link to its page.
type ProductRow struct{ P domain.Product }

func (r ProductRow) Render(c *ui.Ctx) *ui.Element {
	th, p := ui.UseTheme(c), r.P
	return router.Link(fmt.Sprintf("/products/%d", p.ID),
		ui.Style{Direction: ui.Row, AlignItems: ui.AlignCenter, Gap: th.SpaceM, Padding: ui.XY(th.SpaceL, 12),
			Background: th.Surface, Margin: ui.Edges{Bottom: 1}},
		tile(th, p.Emoji, 52),
		ui.View(ui.Style{Grow: 1, Shrink: 1, Gap: 2},
			ui.Text(p.Name, ui.Style{FontSize: th.Body, FontWeight: 600}),
			ui.Text(p.Category, ui.Style{FontSize: th.Caption, Color: th.TextMuted}),
		),
		ui.Text(utils.Money(p.Price), ui.Style{FontSize: th.Body, FontWeight: 600}),
	).TestID(fmt.Sprint("product-", p.ID))
}

// ProductScreen is one product, with Add to cart (the page at /products/:id).
type ProductScreen struct{ ID int }

func (s ProductScreen) Render(c *ui.Ctx) *ui.Element {
	th, client := ui.UseTheme(c), services.API(c)
	q := ui.UseQuery(c, data.ProductKey(s.ID), func(ctx context.Context) (domain.Product, error) { return data.Get(ctx, client, s.ID) })
	inCart := cart.Store.Use(c)
	switch {
	case q.Err != nil && !q.Loaded:
		return ui.C(widgets.Problem{Message: q.Err.Error(), Retry: q.Refetch})
	case !q.Loaded:
		return widgets.Loading()
	}
	p := q.Data
	qty := 0
	for _, l := range inCart {
		if l.Product.ID == p.ID {
			qty = l.Qty
		}
	}
	add := func() {
		cart.Store.Update(c, func(ct cart.Cart) cart.Cart { return ct.Add(p) })
		go dialog.Toast(context.Background(), p.Name+" added to your cart") // no toasts on the web: fine
	}
	label := "Add to cart"
	if qty > 0 {
		label = fmt.Sprintf("Add another (%d in cart)", qty)
	}
	return ui.SafeArea(ui.Style{Grow: 1}, ui.Scroll(ui.Style{Grow: 1, Shrink: 1}, ui.View(ui.Style{Padding: ui.All(th.SpaceL), Gap: th.SpaceL},
		ui.View(ui.Style{AlignItems: ui.AlignCenter}, tile(th, p.Emoji, 140)),
		ui.View(ui.Style{Gap: th.SpaceS},
			ui.Text(p.Name, ui.Style{FontSize: th.Title, FontWeight: 700}).TestID("product-name"),
			ui.Text(p.Category+" · "+utils.Money(p.Price), ui.Style{FontSize: th.Body, Color: th.TextMuted}),
		),
		ui.Text(p.Description, ui.Style{FontSize: th.Body}),
		ui.C(widgets.Button{Label: label, OnPress: add}).TestID("add-to-cart"),
		router.Link("/cart", ui.Style{AlignItems: ui.AlignCenter, Padding: ui.All(8)},
			ui.Text("Go to cart", ui.Style{Color: th.Primary, FontWeight: 600})),
	)))
}

// tile is a product's picture: its emoji on a soft square.
func tile(th ui.Theme, emoji string, size float32) *ui.Element {
	return ui.View(ui.Style{Width: ui.Pt(size), Height: ui.Pt(size), Radius: size / 4, Background: th.Border,
		Justify: ui.JustifyCenter, AlignItems: ui.AlignCenter},
		ui.Text(emoji, ui.Style{FontSize: size / 2}))
}
