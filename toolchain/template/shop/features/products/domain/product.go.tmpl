// Package domain is the catalog's contract.
package domain

import "github.com/CodeSyncr/nimbus-native/api"

type Product struct {
	ID          int     `json:"id"`
	Name        string  `json:"name"`
	Emoji       string  `json:"emoji"` // stands in for a photo
	Price       float64 `json:"price"`
	Category    string  `json:"category"`
	Description string  `json:"description"`
}

// ProductRef names one product.
type ProductRef struct {
	ID int `path:"id" json:"-"`
}

var (
	ListProducts = api.GET[api.None, []Product]("/api/products")
	GetProduct   = api.GET[ProductRef, Product]("/api/products/{id}")
)
