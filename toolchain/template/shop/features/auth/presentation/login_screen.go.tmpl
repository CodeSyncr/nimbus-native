// Package presentation is sign-in's screen.
package presentation

import (
	"context"

	"github.com/CodeSyncr/nimbus-native/router"
	"github.com/CodeSyncr/nimbus-native/ui"
	"github.com/CodeSyncr/nimbus-native/ui/render"

	"__MODULE__/features/auth/data"
	"__MODULE__/features/auth/domain"
	"__MODULE__/shared/services"
	"__MODULE__/shared/widgets"
)

// LoginScreen signs in (the page at /login). The server checks the
// credentials; its errors show on the fields.
type LoginScreen struct{}

func (LoginScreen) Render(c *ui.Ctx) *ui.Element {
	th := ui.UseTheme(c)
	form := ui.UseForm(c, domain.Credentials{}, nil)
	login := ui.UseAction(c, func(ctx context.Context, cr domain.Credentials) (domain.Session, error) {
		s, err := data.Login(ctx, services.API(c), cr)
		form.SetErrors(err)
		return s, err
	}, func(s domain.Session) {
		services.SignIn(c, s)
		// Back to where sign-in was asked for, or to the account.
		if nav := ui.Navigation(c); nav != nil && nav.Depth() > 1 {
			nav.Pop()
		} else {
			router.Push(c, "/account")
		}
	})
	return ui.SafeArea(ui.Style{Grow: 1, Padding: ui.All(th.SpaceL), Gap: 16},
		ui.Text("Sign in", ui.Style{FontSize: th.Title, FontWeight: 700}),
		ui.TextField(form.Field("email", func(cr *domain.Credentials) *string { return &cr.Email }),
			ui.FieldOptions{Label: "Email", Placeholder: "you@example.com", Keyboard: render.KeyboardEmail}),
		ui.TextField(form.Field("password", func(cr *domain.Credentials) *string { return &cr.Password }),
			ui.FieldOptions{Label: "Password", Secure: true}),
		ui.C(widgets.Button{Label: "Sign in", BusyLabel: "Signing in…", Busy: login.Running,
			OnPress: func() { login.Run(form.Value()) }}).TestID("login"),
		ui.Text("Demo account: demo@shop.dev / password", ui.Style{FontSize: th.Caption, Color: th.TextMuted, TextAlign: ui.AlignCenter}),
	)
}
