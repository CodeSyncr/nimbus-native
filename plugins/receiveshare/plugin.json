{ "description": "Receive text, links, pictures and files from the share sheet", "handler": "ReceiveSharePlugin",
  "ios": {
    "shareExtension": true,
    "entitlementArrays": { "com.apple.security.application-groups": ["group.$(PRODUCT_BUNDLE_IDENTIFIER)"] } },
  "android": {
    "application": ["<activity android:name=\"space.nimbusgo.nativekit.ShareReceiverActivity\" android:exported=\"true\" android:theme=\"@android:style/Theme.NoDisplay\"><intent-filter><action android:name=\"android.intent.action.SEND\" /><category android:name=\"android.intent.category.DEFAULT\" /><data android:mimeType=\"*/*\" /></intent-filter><intent-filter><action android:name=\"android.intent.action.SEND_MULTIPLE\" /><category android:name=\"android.intent.category.DEFAULT\" /><data android:mimeType=\"*/*\" /></intent-filter></activity>"] } }
